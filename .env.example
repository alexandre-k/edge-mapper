# Edge Mapper — Environment Variables Template
#
# Copy this file to `.env` (gitignored) and run or build with:
#   ./scripts/run_web_https.sh                          (auto-loads .env if present)
#   flutter run --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env
#   flutter build web --release --dart-define-from-file=.env
#
# Leave unused values blank. Sensitive credentials entered inside the app
# (OSM OAuth tokens, Gemini/Custom AI keys, sync codes) are encrypted via
# OS Keystore (Android) or WebAuthn Passkey (Bitwarden / YubiKey) / WebCrypto.

# --- App Identity & OSMF Policy Compliance ---
# Real public repository URL or contact email sent in HTTP User-Agent headers
# to OpenStreetMap tile servers, Nominatim, Overpass, Taginfo, and OSM API v0.6.
# Required by OSMF Tile & Nominatim Usage Policies (never use openstreetmap.org).
APP_CONTACT_URL=
# Optional custom {z}/{x}/{y} (and optional {s}) raster tile URL template for
# bulk offline area pre-downloading (e.g. MapTiler, Protomaps, or self-hosted).
# Bulk pre-downloads never target tile.openstreetmap.org.
OFFLINE_TILE_URL_TEMPLATE=

# --- Firebase (Web & Android) ---
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MEASUREMENT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
# Self-hosted attest-gate base URL for Android Hardware Key Attestation App Check (e.g. https://attest-gate.example.com).
# Leave blank to skip AttestGate App Check initialization.
ATTEST_GATE_BASE_URL=

# --- OpenStreetMap OAuth 2.0 Developer App Config ---
# Register ONE public (non-confidential) OAuth 2.0 app on openstreetmap.org (and optionally
# one on master.apis.dev.openstreetmap.org for sandbox testing) with scopes:
#   read_prefs, write_api, write_gpx
# and these Redirect URIs (one per line in OSM OAuth 2 app settings):
#   edgemapper://oauth2/callback
#   https://localhost:8443/osm_callback.html
# Leave OSM_REDIRECT_URI blank so Android uses edgemapper://oauth2/callback and Web uses <origin>/osm_callback.html.
OSM_CLIENT_ID=
OSM_SANDBOX_CLIENT_ID=
OSM_REDIRECT_URI=
OSM_USE_SANDBOX=false
OSM_CHANGESET_COMMENT=Field survey via Edge Mapper

# --- AI Engine Defaults (optional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# --- Cloud Sync & Explorer Defaults (optional) ---
FIREBASE_SYNC_SPACE_ID=
EXPLORER_HANDLE=

# --- Bitcoin Developer Donations ---
# Unified Bitcoin URI (BIP-21 / BIP-321), e.g. BOLT 12 offer ("bitcoin:?lno=lno1...")
BTC_DONATION_URI=
# Standard on-chain Taproot (P2TR "bc1p...") or SegWit ("bc1q...") address
BTC_DONATION_P2TR_ADDRESS=
# Lightning Address ("user@domain.tld") or LNURL ("lnurl1...")
BTC_DONATION_LIGHTNING_ADDRESS=
# Silent Payment static address (BIP-352 "sp1q..." / "tsp1q...")
BTC_DONATION_SILENT_PAYMENT_ADDRESS=
# Optional standalone BOLT 12 offer ("lno1...")
BTC_DONATION_BOLT12_OFFER=
# Optional self-hosted BTCPay Server donation / PoS / checkout URL
BTC_DONATION_BTCPAY_URL=
